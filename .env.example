# .env.example — modèle de configuration (À COPIER en .env, qui NE doit PAS être versionné)
# Génère une clé JWT robuste, par ex. :  openssl rand -base64 48

# --- Base de données ---
DB_NAME=cesizen
DB_USER=cesizen
DB_PASSWORD=CHANGE_ME_mot_de_passe_fort
DB_ROOT_PASSWORD=CHANGE_ME_root_fort

# --- API .NET ---
ASPNETCORE_ENVIRONMENT=Production

# --- JWT (les 3 valeurs sont obligatoires, sinon l'API refuse de démarrer) ---
JWT_ISSUER=CesiZen
JWT_AUDIENCE=CesiZenClient
JWT_KEY=CHANGE_ME_cle_base64_256_bits
